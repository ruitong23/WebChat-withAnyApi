[Unit]
Description=Lumen Studio server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lumen
ExecStart=/usr/bin/node /opt/lumen/scripts/dev.mjs
Environment=LUMEN_HOST=127.0.0.1
Environment=PORT=4177
Environment=LUMEN_DATA_DIR=/var/lib/lumen
EnvironmentFile=-/etc/lumen/lumen.env
StateDirectory=lumen
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
